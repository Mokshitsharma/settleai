# SettleAI environment (spec Appendix A). Copy to .env.local. Every variable is optional:
# with nothing set the app runs in MOCK mode with the offline AI stub.

# --- Mode -----------------------------------------------------------------------------------
# MOCK or LIVE. Unset = LIVE only when PayPal keys are present. MOCK forces the mock even with keys.
APP_MODE=

# --- Database -------------------------------------------------------------------------------
# Unset = embedded PGlite stored in PGLITE_DATA_DIR. Set for real Postgres (Render, CI).
DATABASE_URL=
PGLITE_DATA_DIR=

# --- PayPal (sandbox) -------------------------------------------------------------------------
PAYPAL_ENV=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Needed for webhook signature verification in LIVE mode
PAYPAL_WEBHOOK_ID=

# --- LLM ------------------------------------------------------------------------------------
# xai | groq | anthropic | stub. Unset = the first provider whose key is present (xai, groq, anthropic), else stub.
LLM_PROVIDER=
# Defaults: xai grok-4.7, groq qwen/qwen3.8-27b
LLM_MODEL=
# Groq only: model for text-only agents (Scoping, Arbiter). LLM_MODEL stays the vision model.
LLM_TEXT_MODEL=
XAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# --- Storage for proofs ---------------------------------------------------------------------
STORAGE_DRIVER=
STORAGE_LOCAL_DIR=

# --- Money and policy -----------------------------------------------------------------------
# Platform fee in basis points (200 = 2%)
PLATFORM_FEE_BPS=
# Demo uses 15
CHALLENGE_WINDOW_SECONDS=
# Demo uses 45
DISPUTE_EVIDENCE_WINDOW_SECONDS=
# Emergency stop for all payouts
PAYOUT_KILL_SWITCH=
# Mock failure injection (0..1) and capture latency
MOCK_PAYOUT_FAIL_RATE=
MOCK_CAPTURE_DELAY_MS=

# --- Security -------------------------------------------------------------------------------
# Dev defaults exist; always set real random values in deployed environments. A deployment (NODE_ENV=production
# or DATABASE_URL set) refuses to start without API_KEY_PEPPER.
SESSION_SECRET=
API_KEY_PEPPER=
# Platform ES256 private key as a JWK (generated for dev if unset)
PLATFORM_SIGNING_KEY_JWK=

# --- Mandates -------------------------------------------------------------------------------
# browser | managed | both
KEY_MODE=
MANDATE_DEFAULT_TTL_SECONDS=
STEP_UP_ABOVE_MINOR=
# live (LLM agent) or scripted
PROCUREBOT_MODE=
# ProcureBot's agent API key. Locally it defaults to the published demo key; a deployment must set its own.
# Optional. Unset: each local seed generates a random key in .data/procurebot-key (git-ignored).
# On a deployment an unset key means the agent API stays closed.
PROCUREBOT_API_KEY=

# --- Precedent search (P2) ------------------------------------------------------------------
ELASTIC_URL=
ELASTIC_API_KEY=

# Required by docker-compose.yml
POSTGRES_PASSWORD=

# --- Live demo and tooling ---
# Public URL for PayPal return links. Render sets RENDER_EXTERNAL_URL, so this is usually unset.
APP_URL=
# PayPal sandbox personal account that receives payouts in LIVE mode.
SANDBOX_WORKER_EMAIL=
# PayPal sandbox buyer login, used by scripts/live-flow.ts and the video recorder. Never commit.
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=
# Optional: where a local seed saves its generated ProcureBot key.
PROCUREBOT_KEY_FILE=
# Optional: model for ProcureBot live mode.
PROCUREBOT_MODEL=
# Optional: false skips the two weeks of demo history.
SEED_HISTORY=
# MCP client settings.
SETTLEAI_URL=
SETTLEAI_API_KEY=
# 1 runs pnpm eval against the live LLM.
DEMO_PHOTOS_DIR=
EVAL_LIVE=
